<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.compi2.codexlatinus.gui.controllers.PigLatinController">
    <center>
        <TextArea fx:id="areaPigLatin" editable="false" wrapText="true"
                  style="-fx-font-family: 'Consolas'; -fx-font-size: 13px;"/>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
            <Button text="Guardar como .pig" onAction="#guardarComoPig"/>
        </HBox>
    </bottom>
</BorderPane>